PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acop
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:5173
VERIFY_DB_ON_STARTUP=true

# Integration tests. Leave unset to skip DB-backed integration tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acop_test
TEST_DATABASE_SSL=false
TEST_API_BASE_URL=http://127.0.0.1:4010

# Modem driver. Default is mock for local development.
MODEM_DRIVER=mock
MODEM_SERIAL_PORT=COM3